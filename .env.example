# Plantilla de Configuración de Entorno para Asignación AACH
# Duplicar este archivo como '.env' en la raíz y configurar con sus credenciales

# ID de la Hoja de Cálculo en Google Sheets (extraído de la URL https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=1A2B3C4D5E6F7G8H9I0JKLMNOPQRSTUVWXYZ_example

# Credenciales OAuth 2.0 Web / Desktop (Opcional si se usa google-services.json en Android)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Teléfono del Despacho / Coordinación Central (Código de país + número, ej: 521XXXXXXXXXX)
COORDINACION_PHONE=+5215512345678

# Nombre del Despacho
DESPACHO_NAME=AACH Ajustadores Asociados
